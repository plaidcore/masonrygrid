{
   "name": "masonrygrid",
   "private": true,
   "workspaces": [
      "packages/core",
      "packages/react",
      "packages/angular"
   ],
   "description": "Masonry grid for every framework",
   "license": "ISC",
   "engines": {
      "node": ">=18"
   },
