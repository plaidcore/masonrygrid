{
  "name": "@masonrygrid/vue",
  "version": "0.9.2",
  "description": "Masonry grid component for Vue",
  "keywords": [
    "masonry",
    "grid",
    "vue",
    "layout"
  ],
  "license": "ISC",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@masonrygrid/core": "^0.9.2"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "~5.8.0",
    "vue": "^3.5.0"
  },
  "homepage": "https://github.com/plaidcore/masonrygrid#readme",
  "bugs": {
    "url": "https://github.com/plaidcore/masonrygrid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plaidcore/masonrygrid.git",
    "directory": "packages/vue"
  }
}
